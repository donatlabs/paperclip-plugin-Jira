{
  "name": "@donatlabs/paperclip-plugin-jira",
  "version": "0.2.1",
  "description": "Jira integration for Paperclip \u2014 syncs issues, boards, sprints, and workflows with the Paperclip platform",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc && node ./scripts/build-worker.mjs && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "^2026.831.1",
    "@paperclipai/shared": "^2026.831.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "jira",
    "issues",
    "boards",
    "sprints",
    "agile"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donatlabs/paperclip-plugin-Jira.git"
  }
}
